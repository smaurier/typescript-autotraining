{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": { "@lab/*": ["./solution/*"] },
    "isolatedModules": true,
    "erasableSyntaxOnly": true
  },
  "include": ["solution", "test"]
}
